---
import BaseLayout from "../layouts/BaseLayout.astro";
import TimeLineElement from "../components/cv/TimeLine.astro";
import { experience } from "../lib/experience.ts";
---

<BaseLayout title="Experience" sideBarActiveItemID="cv">

  <!-- Page Title -->
  <div class="text-left">
    <h2 class="text-3xl font-bold mb-8">EXPERIENCE</h2>
  </div>

  <!-- Experience Section -->
  <div class="space-y-12">
    {experience.map((exp) => (
      <TimeLineElement title={exp.title}>
        <div class="flex items-center gap-3 mb-2">
          <img src={exp.logo} alt={exp.company.name} class="w-7 h-7 rounded-sm shadow-sm" />
          <div class="text-gray-700 text-sm flex flex-wrap items-center gap-1">
            <a href={exp.company.link} target="_blank" class="underline hover:no-underline font-medium">
              {exp.company.name}
            </a>
            <span>|</span>
            <span>{exp.duration}</span>
          </div>
        </div>

        <!-- Experience Description Categories & Points -->
        <div class="mt-3 space-y-4">
          {exp.description.map((category) => (
            <div class="bg-gray-50 border border-gray-200 rounded-lg p-4 shadow-sm">
              <div class="text-sm font-semibold text-gray-800 mb-1 flex items-center gap-2">
                <span class="inline-block w-1.5 h-1.5 bg-blue-500 rounded-full"></span>
                {category.category}
              </div>
              <ul class="list-disc list-inside text-gray-700 text-sm space-y-1">
                {category.points.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </TimeLineElement>
    ))}
  </div>

</BaseLayout>
