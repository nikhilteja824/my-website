---
import BaseLayout from "../layouts/BaseLayout.astro";
import { socials } from "../lib/socials.ts";

const email = "nikhilteja85@gmail.com";
---

<BaseLayout title="Contact" sideBarActiveItemID="contact">
  <section class="text-left space-y-8">
    <div>
      <h2 class="text-3xl font-bold">CONTACT</h2>
      <p class="text-gray-600 mt-2 max-w-xl">
        Whether it's about software engineering, system design, projects or just saying hi — I'm always open to interesting conversations and opportunities.
      </p>
    </div>

    <!-- Contact Details -->
<div class="flex items-center gap-6 text-sm text-gray-700">
  <div class="flex items-center gap-2">
    <img src="https://api.iconify.design/mdi:email-outline.svg" alt="email" class="w-5 h-5" />
    <a href={`mailto:${email}`} class="hover:underline">
      <span class="select-all">{email}</span>
    </a>
  </div>

  <div class="flex items-center gap-2">
    <img src="https://api.iconify.design/mdi:map-marker-outline.svg" alt="location" class="w-5 h-5" />
    <span>New York, US</span>
  </div>
</div>


    <!-- Social Icons -->
    <div class="flex flex-wrap items-center gap-4">
      {socials.map((social) => (
        <a
          href={social.link}
          target="_blank"
          aria-label={social.name}
          class="hover:opacity-70 transition"
        >
          <img
            src={`https://api.iconify.design/${social.icon}.svg`}
            alt={social.name}
            class="w-6 h-6"
          />
        </a>
      ))}
    </div>

    <!-- Contact Form -->
    <div class="bg-white border border-gray-200 shadow-sm rounded-xl px-6 py-8 max-w-xl">
      <h3 class="text-2xl font-semibold mb-6 text-center">Get in Touch</h3>
      <form class="space-y-4">
        <input type="text" placeholder="Your Name" class="input input-bordered w-full" />
        <input type="email" placeholder="Your Email" class="input input-bordered w-full" />
        <textarea placeholder="Message" class="textarea textarea-bordered w-full h-28"></textarea>

        <div class="flex justify-center">
          <button type="submit"
            class="bg-blue-600 text-white font-semibold px-6 py-2 rounded-md hover:bg-blue-700 transition inline-flex items-center gap-2">
            Send Message
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M22 2L11 13" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M22 2L15 22l-4-9-9-4 20-7z" />
        </svg>
          </button>
        </div>
      </form>
    </div>
  </section>
</BaseLayout>
