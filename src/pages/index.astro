---
import BaseLayout from "../layouts/BaseLayout.astro";
import { testimonials } from "../lib/testimonials.ts";
---

<BaseLayout sideBarActiveItemID="home">
  <div class="mt-6 lg:max-w-[1200px] px-4 sm:px-8">
    <!-- Page Title -->
    <h1 class="text-4xl font-extrabold tracking-tight text-gray-800 mb-1 uppercase">About Me</h1>
    <p class="text-sm text-gray-500 border-b pb-4 mb-6">— In About 786 Words —</p>

    <!-- Hero/Intro Section -->
    <section class="mb-12">
      <h2 class="text-2xl font-semibold mb-2">👋 <span class="align-middle">Hey there!</span></h2>
      <p class="text-lg text-gray-700 leading-relaxed">
        I’m a Master’s student in Computer Science at <strong>Stony Brook University</strong>, and an alumnus of <strong>IIT Roorkee</strong>. Passionate about <strong>backend development</strong>, <strong>distributed systems</strong>, and <strong>cloud infrastructure</strong>.
      </p>
    </section>

    <!-- Education Timeline -->
    <section class="mb-16">
      <h2 class="text-2xl font-semibold flex items-center gap-2 mb-6">📚 Education</h2>
      <div class="relative ml-4 border-l-2 border-blue-400 pl-6 space-y-6">
        <div>
          <div class="text-blue-700 font-semibold">Stony Brook University</div>
          <div class="text-gray-700">MS in Computer Science (2024 - Present)</div>
        </div>
        <div>
          <div class="text-blue-700 font-semibold">IIT Roorkee</div>
          <div class="text-gray-700">B.Tech in Electrical Engineering (2016 - 2020)</div>
        </div>
      </div>
    </section>

    <!-- Industry Experience -->
    <section class="mb-16 border-t pt-10">
      <h2 class="text-2xl font-semibold flex items-center gap-2 mb-4">💼 Industry Experience</h2>
      <p class="text-lg text-gray-700 leading-relaxed">
        I have over <strong>2 years</strong> of experience at <strong>Myntra</strong> as a Software Engineer, working on scalable systems and real-time backend operations.
      </p>
    </section>

    <!-- Background Section -->
    <section class="mb-16 border-t pt-10">
      <h2 class="text-2xl font-semibold mb-4">🧩 My Background</h2>
      <ul class="list-disc pl-6 text-lg text-gray-700 leading-relaxed space-y-2">
        <li>Grew up in India, developing a deep interest in mathematics and engineering.</li>
        <li>Completed undergraduate studies at IIT Roorkee in Electrical Engineering.</li>
        <li>Developed hands-on software skills in distributed systems & backend development.</li>
        <li>Worked at Myntra as a Software Development Engineer, leading impactful backend projects.</li>
        <li>Currently pursuing a Master’s at Stony Brook University, specializing in cloud infrastructure.</li>
      </ul>
    </section>

    <!-- Testimonials Section -->
    <section class="mb-16 border-t pt-10">
      <h2 class="text-2xl font-semibold flex items-center gap-2 mb-6">💬 Perspectives on My Work</h2>
      <div class="grid md:grid-cols-2 gap-6">
        {testimonials.map((testimonial) => (
          <div class="p-6 border border-gray-200 rounded-xl shadow-sm bg-white">
            <p class="text-gray-700 italic">"{testimonial.text}"</p>
            <div class="mt-4 text-gray-900 font-medium">
              {testimonial.name} • {testimonial.position}
            </div>
          </div>
        ))}
      </div>
      <div class="mt-4">
        <a href="https://www.linkedin.com/in/nikhiltejamalyala/details/recommendations/" target="_blank" class="text-blue-600 hover:text-blue-800 text-lg font-semibold">
          View more on LinkedIn →
        </a>
      </div>
    </section>

    <!-- Beyond the Code -->
    <section class="mb-16 border-t pt-10">
      <h2 class="text-2xl font-semibold mb-4">🧠 Beyond the Code</h2>
      <ul class="list-disc pl-6 text-lg text-gray-700 leading-relaxed space-y-2">
        <li>Fascinated by system scalability and distributed architectures.</li>
        <li>Enjoy deep tech reads and backend design discussions.</li>
        <li>Love exploring cloud-native workflows and containerization.</li>
        <li>Constantly learning, building, and refining my tools & setups.</li>
      </ul>
    </section>

    <!-- Fun Facts -->
    <section class="mb-24 border-t pt-10">
      <h2 class="text-2xl font-semibold mb-4">🎯 Fun Facts</h2>
      <ul class="list-disc pl-6 text-lg text-gray-700 leading-relaxed space-y-2">
        <li>I often refactor code just to sleep peacefully 😅</li>
        <li>Spent more time customizing my terminal than using it</li>
        <li>Resume word choice = 30 minutes of internal debate</li>
        <li>Unofficial tech support guy for all friends & family</li>
      </ul>
    </section>
  </div>
</BaseLayout>