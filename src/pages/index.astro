---
import BaseLayout from "../layouts/BaseLayout.astro";
import { testimonials } from "../lib/testimonials.ts";
import { education } from "../lib/education.ts";
import { experience } from "../lib/experience.ts";

const baseURL = import.meta.env.BASE_URL;

const highlights = [
  { metric: "1.5M+", label: "Requests/min", detail: "Scaled Myntra's discount service" },
  { metric: "70%", label: "Manual Effort Saved", detail: "AI agent for legal doc automation" },
  { metric: "58%", label: "Faster Startup", detail: "Spring Boot 3.1 + Java 17 migration" },
  { metric: "25%", label: "Infra Cost Reduction", detail: "VM to Kubernetes migration" },
];
---

<style>
  .gradient-text {
    background: -webkit-linear-gradient(45deg, #3b82f6, #8b5cf6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }
</style>

<BaseLayout sideBarActiveItemID="home">
  <div class="mx-auto max-w-4xl px-4 sm:px-8 py-12">
    <section class="text-center mb-16">
      <h1 class="text-5xl md:text-6xl font-extrabold tracking-tight text-gray-900 mb-4">
        Hey, I'm <span class="gradient-text">Nikhil</span>
      </h1>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
        I'm a software engineer pursuing my Master's in Computer Science at <strong>Stony Brook University</strong>, with a foundation from <strong>IIT Roorkee</strong>. I spent <strong>2+ years</strong> at <strong>Myntra</strong> building high-throughput backend systems handling millions of requests per minute. More recently at <strong>ReTax360</strong>, I built <strong>AI agents</strong> and <strong>RAG pipelines</strong> to automate document workflows using LLMs in production.
      </p>
      <div class="mt-6 flex items-center justify-center gap-3">
        <a
          href={`${baseURL}contact/`}
          class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors duration-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          Contact
        </a>
        <a
          href="https://drive.google.com/file/d/1-YGXKOZbDtm-n0xh22uGOWDYMDjzs13u/view?usp=drive_link"
          target="_blank"
          class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-semibold bg-white text-gray-800 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors duration-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
          Resume
        </a>
      </div>
    </section>

    <section class="grid md:grid-cols-2 gap-8 mb-20">
      <div class="bg-gray-50/70 p-8 rounded-2xl">
        <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-3 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          Experience
        </h2>
        <div class="space-y-5">
          {experience.map((exp) => (
            <div class="flex items-start gap-3">
              {exp.logo && <img src={exp.logo} alt={exp.company.name} class="w-5 h-5 mt-0.5 shrink-0" />}
              <div>
                <a href={exp.company.link} target="_blank" rel="noopener noreferrer" class="font-semibold text-gray-800 hover:underline text-sm">{exp.company.name}</a>
                <p class="text-sm text-gray-600">{exp.title}</p>
                <time class="text-xs text-gray-500">{exp.duration}</time>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-6">
          <a href={`${baseURL}cv/`} class="text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors">
            View full experience &rarr;
          </a>
        </div>
      </div>

      <div class="bg-gray-50/70 p-8 rounded-2xl">
        <h2 class="text-2xl font-bold text-gray-800 flex items-center gap-3 mb-6">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 14l9-5-9-5-9 5 9 5z" /><path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-9.998 12.078 12.078 0 01.665-6.479L12 14z" /></svg>
          Education
        </h2>
        <div class="relative border-l-2 border-gray-200">
          {education.map((edu, index) => (
            <div class={index === education.length - 1 ? 'ml-6' : 'mb-8 ml-6'}>
                <span class="absolute flex items-center justify-center w-3 h-3 bg-blue-500 rounded-full -left-[7px] ring-4 ring-white"></span>
                <h3 class="font-semibold text-gray-800">
                  <a href={edu.institution.link} target="_blank" rel="noopener noreferrer" class="hover:underline">
                    {edu.institution.name}
                  </a>
                </h3>
                <p class="text-sm text-gray-600 mt-1">{edu.title}</p>
                <time class="block text-xs text-gray-500 mt-1">{edu.duration}</time>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mb-20">
      <h2 class="text-3xl font-bold text-gray-800 mb-8 text-center">
        Impact at a Glance
      </h2>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        {highlights.map((item) => (
          <div class="bg-gray-50/70 p-6 rounded-2xl text-center">
            <div class="text-3xl font-extrabold text-blue-600 mb-1">{item.metric}</div>
            <div class="text-sm font-semibold text-gray-800">{item.label}</div>
            <div class="text-xs text-gray-500 mt-1">{item.detail}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="mb-20">
      <div class="bg-gray-50/70 p-8 md:p-12 rounded-2xl">
        <h2 class="text-3xl font-bold text-center text-gray-800 mb-12">
          Perspectives on My Work
        </h2>
        <div class="grid md:grid-cols-2 gap-8">
          {testimonials.map((testimonial) => (
            <div class="bg-white p-8 rounded-xl border border-gray-200 shadow-lg flex flex-col">
              <p class="text-gray-600 italic mb-6 flex-grow" set:html={testimonial.text}></p>
              <div class="text-right">
                <div class="font-bold text-gray-900">{testimonial.name}</div>
                <div class="text-sm text-gray-500">{testimonial.position}</div>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-12 text-center">
          <a
            href="https://www.linkedin.com/in/nikhiltejamalyala/details/recommendations/"
            target="_blank"
            class="inline-flex items-center gap-2 justify-center px-6 py-3 font-semibold bg-blue-100 text-blue-800 rounded-lg hover:bg-blue-200 focus:outline-none focus:ring-2 focus:ring-blue-300 focus:ring-opacity-75 transition-all duration-300"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-linkedin"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
            View more on LinkedIn
          </a>
        </div>
      </div>
    </section>
    <section class="grid md:grid-cols-2 gap-8 mb-16">
        <div class="bg-gray-50/70 p-8 rounded-2xl">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Beyond the Code</h2>
            <ul class="space-y-4 text-gray-700">
                <li class="flex items-start gap-3">
                    <span class="text-blue-500 mt-1 font-bold">&rarr;</span>
                    <span>Fascinated by system scalability and distributed architectures.</span>
                </li>
                <li class="flex items-start gap-3">
                    <span class="text-blue-500 mt-1 font-bold">&rarr;</span>
                    <span>Enjoy deep tech reads and backend design discussions.</span>
                </li>
                <li class="flex items-start gap-3">
                    <span class="text-blue-500 mt-1 font-bold">&rarr;</span>
                    <span>Love exploring cloud-native workflows and containerization.</span>
                </li>
            </ul>
        </div>
        <div class="bg-gray-50/70 p-8 rounded-2xl">
            <h2 class="text-2xl font-bold text-gray-800 mb-6">Fun Facts</h2>
            <ul class="space-y-4 text-gray-700">
                <li class="flex items-start gap-3">
                    <span class="text-purple-500 mt-1 font-bold">&#8226;</span>
                    <span>I often refactor code just to sleep peacefully</span>
                </li>
                <li class="flex items-start gap-3">
                    <span class="text-purple-500 mt-1 font-bold">&#8226;</span>
                    <span>Spent more time customizing my terminal than using it.</span>
                </li>
                <li class="flex items-start gap-3">
                    <span class="text-purple-500 mt-1 font-bold">&#8226;</span>
                    <span>Unofficial tech support for all friends & family.</span>
                </li>
            </ul>
        </div>
    </section>
  </div>
</BaseLayout>
