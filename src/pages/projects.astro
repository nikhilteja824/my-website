---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../lib/projects.ts";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <header class="mb-12 text-left">
    <h1 class="text-3xl font-bold">PROJECTS</h1>
    <p class="text-gray-600 mt-2">
      Some of my projects over the years.
    </p>
  </header>

  <div class="space-y-16">
    {projects.map((project, index) => (
      <div class="bg-white border border-gray-300 rounded-xl overflow-hidden shadow-sm transition-all duration-300 ease-in-out hover:shadow-xl hover:-translate-y-1">
        <div class={`grid md:grid-cols-2 gap-8 items-center`}>
          <div class={`p-6 ${index % 2 !== 0 ? "md:order-last" : ""}`}>
            <img src={project.img} alt={project.title} class="rounded-lg w-full shadow-md" />
          </div>

          <div class="p-6">
            <h2 class="text-xl font-bold mb-2">
              <a href={project.url} target="_blank" class="hover:underline">{project.title}</a>
            </h2>

            <p class="text-gray-700 leading-relaxed text-sm">
              {project.description}
            </p>

            <div class="mt-4 flex flex-wrap gap-2">
              {project.tech.map((tech) => (
                <span class="px-3 py-1 text-xs font-semibold bg-blue-100 text-blue-800 rounded-full">
                  {tech}
                </span>
              ))}
            </div>

            <div class="flex items-center gap-4 mt-6">
              {project.github && (
                <a href={project.github} target="_blank" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6.1a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.7 2.7 5.8 5.5 6.1-.6.5-.9 1.2-.9 2.2V22"/></svg>
                  Source
                </a>
              )}
              {project.liveDemo && (
                <a href={project.liveDemo} target="_blank" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
                  Demo
                </a>
              )}
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
</BaseLayout>