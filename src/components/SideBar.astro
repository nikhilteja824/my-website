---
import SideBarFooter from "./SideBarFooter.astro";
import { Image } from "astro:assets";
import SideBarMenu from "./SideBarMenu.astro";
const { sideBarActiveItemID } = Astro.props;
const baseURL = import.meta.env.BASE_URL;
---

<div class="drawer-side z-40">
  <label for="my-drawer" class="drawer-overlay"></label>
  <aside class="px-4 pt-8 h-auto min-h-full w-[19rem] bg-base-200 text-base-content flex flex-col justify-between">
    
    <div>
      <div class="flex flex-col items-center text-center w-full">
        <a href="/">
          <div class="avatar transition ease-in-out hover:scale-[102%] block">
            <div class="w-36">
              <Image class="mask mask-circle" format="webp" width={300} height={300} src={`${baseURL}profile_cropped.png`} alt="Profile image" />
            </div>
          </div>
        </a>
      
        <h1 class="mt-4 text-2xl font-bold text-base-content">
          Nikhil Teja Malyala
        </h1>
      
        <div class="mt-2 flex items-center gap-2">
          <span class="relative flex h-2.5 w-2.5">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
          </span>
          <p class="text-sm text-gray-500">
            Software Engineer
          </p>
        </div>
        
      
        <p class="text-xs text-gray-400 mt-2">
          <a href="mailto:nikhilteja85@gmail.com" class="hover:underline">nikhilteja85@gmail.com</a>
        </p>
      </div>

      <SideBarMenu sideBarActiveItemID={sideBarActiveItemID} />
    </div>

    <div class="pb-4">
       <SideBarFooter />
    </div>

  </aside>
</div>